# AVATAR Backend - Environment Variables
# Gerçek değerleri bu dosyaya kaydedin

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=avatar_db

# Application Configuration
APP_ENV=development
APP_PORT=8080

# JWT Configuration (if needed)
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=24h

# Logging Configuration
LOG_LEVEL=debug
